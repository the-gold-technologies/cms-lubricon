# =========================================================================
# Lubricon Specialities India CMS - Environment Configuration Example
# =========================================================================

DATABASE_URL="postgresql://user:password@localhost:5432/lubricon_cms"
DIRECT_URL="postgresql://user:password@localhost:5432/lubricon_cms"

AUTH_SECRET="your-auth-secret-key-here"
NEXTAUTH_URL="http://localhost:3001"
ALLOWED_ORIGINS="*"

# Lubricon Live Frontend Website URL
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# SMTP Mail Dispatch Configuration
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Lubricon Specialities India <no-reply@lubricon.in>"
ADMIN_NOTIFICATION_EMAIL="admin@lubricon.in"
